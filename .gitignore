# Runtime data (never ship customer data with the source)
data/uploads/*
data/processed/*
data/exports/*
data/backups/*
data/logs/*
!data/uploads/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep
!data/backups/.gitkeep
!data/logs/.gitkeep

